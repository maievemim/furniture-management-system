# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# ค่าจาก Supabase → Project Settings → API Keys (ใช้ Publishable key เท่านั้น ห้ามใช้ Secret/service_role key)
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# ไม่บังคับ: บัญชีแอดมินสำหรับรัน E2E test ส่วนหน้าแอดมิน (ไม่ถูกใช้ในหน้าเว็บ)
ADMIN_EMAIL=
ADMIN_PASSWORD=
